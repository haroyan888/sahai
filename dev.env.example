# dev.compose.yaml(開発用の完結したcomposeファイル)専用の環境変数サンプル。
# コピーして dev.env を作り、必要なら値を変更する(dev.envはコミットしない)。
#
#   cp dev.env.example dev.env
#   docker compose -f dev.compose.yaml --env-file dev.env up -d --build
#
# 開発では setup.sh を使わない。setup.sh が対話で聞く項目はここから渡せるように
# してあり、SAHAI_API_TOKEN と SAHAI_DOMAIN を埋めておけばWeb UIの初期設定画面を
# 通らずに起動する。空のままなら従来どおり初期設定画面から設定する。
#
# 【重要】DBが空の初回起動時にしか読まれない。
# 一度 ./data/db/sahai.sqlite3 ができると、以降はDBの値が正になり
# ここの変更は無視される(Web UIの設定画面から変更すること)。
# 読み直させたい場合は down してから ./data を消して起動し直す。
#
# 本番用の .sahai.env とは別ファイルにしている。あちらは sahai-server 自身が
# 書き換える内部ファイルで、こちらは開発機のローカル事情のためのものと性質が異なる。

# ------------------------------------------------------------
# 開発機のローカル事情
# ------------------------------------------------------------

# Traefikのhttp(:80)をホストへ公開するポート。省略時80。開発機で80番が別プロセス
# (他のWebサーバー等)と衝突する場合に変更する。コンテナ内側は常に80のまま
SAHAI_TRAEFIK_HTTP_PORT=

# ------------------------------------------------------------
# 初期設定(本番では setup.sh が POST /api/setup で投入する項目)
# ------------------------------------------------------------

# 管理APIのトークン。**空なら初期設定画面が出る**(下のSAHAI_DOMAINと両方が
# 非空のときだけ、初回起動時にDBへシードされる)。CLI(`sahai`コマンド)からも
# この値を使う。開発機のTraefikは80/443をホストへ公開するため、同一LANから
# 到達しうる。推測されにくい値を入れること:
#   openssl rand -hex 32
SAHAI_API_TOKEN=

# 開発環境で使うベースドメイン。省略時localhost(この場合`sahai.localhost`で
# アクセスする)。LAN内の別端末からアクセスしたい場合など、localhost以外の
# ドメインを使いたい場合はここに設定する。
# Traefikコンテナ自身もこの値を環境変数として受け取り、開発用ルート
# (traefik/dev-dynamic/dev-routes.yml)のHost()ルールをGoテンプレートで組み立てる。
# Traefik側は起動時に一度だけ読むため、後からWeb UIでドメインだけ変えると
# ルーティングが一致しなくなる(その場合はcomposeごと再起動すること)
SAHAI_DOMAIN=

# httpアクセスをhttpsへリダイレクトするか。省略時false(本番の既定はtrue)
SAHAI_HTTPS_REDIRECT=

# ------------------------------------------------------------
# レジストリ(本番では setup.sh が htpasswd 作成 + PUT /api/settings/registry)
# ------------------------------------------------------------

# レジストリのURL。省略時 registry.sahai.<SAHAI_DOMAIN>(Traefikがこのホスト名で
# 待ち受けるため、変更する場合はルーティングの一致に注意すること)
SAHAI_REGISTRY_URL=

# 同梱registryの資格情報。両方を設定すると registry-auth-init が
# ./data/registry-auth/htpasswd を生成し、同じ値がDBへもシードされる
# (`sahai service create`のサーバー側push用)。
# 空のままなら誰も認証できない空のhtpasswdを置く(この同梱registryを使わない場合)
SAHAI_REGISTRY_USERNAME=
SAHAI_REGISTRY_PASSWORD=

# ------------------------------------------------------------
# DNS/証明書(本番では setup.sh が PUT /api/settings/dns-provider)
# ------------------------------------------------------------

# SAHAI_DOMAIN=localhost の開発では証明書を取得できないため、通常は空のままでよい。
# 実ドメインでLet's Encryptの取得まで確認したい場合にのみ設定する。
#
# 【制約】プロバイダ固有の認証情報(CF_DNS_API_TOKEN等)だけはここから渡せない。
# 保存先の .sahai.env はWeb UIの「DNS/証明書設定」からの保存時に sahai-server 自身が
# 書くファイルで、環境変数から取り込む経路が無いため。下の2つを設定したうえで、
# 認証情報はWeb UIの「DNS/証明書設定」から入力すること
SAHAI_DNS_PROVIDER=
SAHAI_ACME_EMAIL=
